<odoo>
    <record id="group_sftp_user" model="res.groups">
        <field name="name">SFTP File Manager: User</field>
    </record>
    <record id="group_sftp_manager" model="res.groups">
        <field name="name">SFTP File Manager: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_sftp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
